# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Your FPL team ID (optional) - from fantasy.premierleague.com/entry/<ID>/event/...
FPL_TEAM_ID=
# Gameweeks to plan ahead (default 5)
FPL_HORIZON=5
# Daily run time for main.py (24h HH:MM)
FPL_RUN_AT=09:00

# ---- Telegram Stars bot ----
# The bot runs on Cloudflare Workers; its settings live in GitHub (see README "Set up").
# To run the hourly publisher locally: TELEGRAM_BOT_TOKEN above + WORKER_URL=https://fpl-ai-bot.<you>.workers.dev
WORKER_URL=
