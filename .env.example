# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Your FPL team ID (optional) - from fantasy.premierleague.com/entry/<ID>/event/...
FPL_TEAM_ID=
# Gameweeks to plan ahead (default 5)
FPL_HORIZON=5
# Daily run time for main.py (24h HH:MM)
FPL_RUN_AT=09:00

# ---- Telegram Stars bot (telegram_bot.py) ----
# Uses TELEGRAM_BOT_TOKEN above. Your bot's @username (no @), used by --setup:
BOT_USERNAME=
# Premium price in Telegram Stars and length in days
STARS_PRICE=150
PREMIUM_DAYS=30
# Your Telegram user ID(s), comma-separated: get /paysupport messages, can /refund and /reply
ADMIN_IDS=
# Optional: shown in /paysupport and /start
SUPPORT_CONTACT=
EXTENSION_URL=
